# Parametros generales de scraping
SCRAPE_INTERVAL_MIN=15
PICKUP_LOCATION=BRC

# Multi-horizonte: lista CSV de "dias a futuro" para el pickup.
# El scheduler corre 1 query por horizonte por agencia (4 horizontes x 4
# agencias = 16 calls por scrape).
HORIZONS_DAYS_AHEAD=0,30,60,90

# Duracion del alquiler en dias (mismo valor para todos los horizontes).
RENTAL_DAYS=7

# HTTP client
HTTP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
HTTP_TIMEOUT=20

# Timezone
TZ=America/Argentina/Buenos_Aires
