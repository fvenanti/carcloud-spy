# Parametros generales de scraping
SCRAPE_INTERVAL_MIN=60
PICKUP_LOCATION=BRC

# Multi-horizonte: lista CSV de "dias a futuro" para el pickup.
# Arrancamos en 1 (mañana) porque Correntoso rechaza pickup mismo día.
# El scheduler corre 1 query por horizonte por agencia.
HORIZONS_DAYS_AHEAD=1,30,60,90

# Duracion del alquiler en dias (mismo valor para todos los horizontes).
RENTAL_DAYS=7

# HTTP client
HTTP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
HTTP_TIMEOUT=20

# Timezone
TZ=America/Argentina/Buenos_Aires

# === API Keys (NO commitear con valores reales — viven en .env del server) ===
# ABA Rent a Car (CarCloud) — pedirla a fvenanti@gmail.com
ABA_API_KEY=

# === Promociones ===
# Hora ART (24h) en la que corre el scrape diario de promos web.
PROMO_SCRAPE_HOUR_ART=8
# Token compartido para ingest de promos IG desde el cliente local Windows.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(24))"
PROMO_INGEST_TOKEN=
